{
  "$schema": "https://opencode.ai/config.json",
  "model": "unsloth/qwen3.8",
  "providers": {
    "unsloth": {
      "name": "Unsloth",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://10.0.2.10:8888/v1",
        "apiKey": "{env:UNSLOTH_API_KEY}"
      },
      "models": {
        "qwen3.8": {
          "name": "Qwen3.8 (local)",
          "modelID": "Qwen3.8-27B-GGUF:UD-Q8_K_XL",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 262144,
          }
        }
      }
    }
  },
  "formatter": {
    "alejandra": {
      "command": [
        "alejandra",
        "$FILE"
      ],
      "extensions": [
        ".nix"
      ]
    }
  }
}
